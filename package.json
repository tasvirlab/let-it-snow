{
  "name": "let-it-snow",
  "productName": "Let It Snow",
  "version": "1.0.2",
  "description": "Snow, a garland, Santa and snowmen on your desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "build": {
    "appId": "uz.letitsnow.app",
    "productName": "Let It Snow",
    "files": [
      "*.js",
      "*.html",
      "assets/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "shortcutName": "Let It Snow",
      "artifactName": "LetItSnow-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "LetItSnow-mac-${arch}.dmg"
    }
  },
  "dependencies": {
    "koffi": "^3.3.7"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
